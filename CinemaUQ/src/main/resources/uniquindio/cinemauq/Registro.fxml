<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.RegistroViewController">
    <VBox alignment="CENTER" spacing="15.0" maxWidth="450.0" style="-fx-background-color: #14141d; -fx-padding: 35; -fx-background-radius: 15;">

        <ImageView fitHeight="60.0" preserveRatio="true">
            <image>
                <Image url="@images/logo_cinemauq.png" />
            </image>
        </ImageView>

        <Label text="Crear Cuenta" styleClass="title-text"/>
        <Label text="Únete a CinemaUQ y empieza a acumular puntos" styleClass="subtitle-text"/>

        <VBox spacing="12.0" style="-fx-padding: 15 0;">
            <TextField fx:id="txtNombreCompleto" promptText="Nombre Completo" styleClass="text-field"/>
            <HBox spacing="10.0">
                <TextField fx:id="txtDocumento" promptText="Identificación" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtEdad" promptText="Edad" styleClass="text-field" prefWidth="100.0"/>
            </HBox>
            <TextField fx:id="txtEmail" promptText="Correo Electrónico" styleClass="text-field"/>
            <TextField fx:id="txtUsuario" promptText="Nombre de Usuario" styleClass="text-field"/>
            <PasswordField fx:id="txtContrasenia" promptText="Contraseña" styleClass="password-field"/>
        </VBox>

        <Button fx:id="btnRegistrar" text="REGISTRARME" maxWidth="Infinity" styleClass="button-primary" onAction="#handleRegistrar"/>

        <HBox alignment="CENTER" spacing="5.0">
            <Label text="¿Ya tienes cuenta?" styleClass="subtitle-text"/>
            <Hyperlink text="Inicia sesión" fx:id="linkLogin" onAction="#handleIrALogin" style="-fx-text-fill: #f5b041; -fx-underline: true;"/>
        </HBox>
    </VBox>
</StackPane>