<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewcontroller.PerfilClienteViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #14141d; -fx-padding: 20 30;">
            <Label text="👤 Mi Perfil CinemaUQ" styleClass="title-text" style="-fx-font-size: 22px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&lt; Volver a Cartelera" styleClass="button-primary" onAction="#handleVolverCartelera"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #0d0d12; -fx-padding: 20;">

            <!-- PESTAÑA 1: TARJETA VIRTUAL Y MOVIMIENTOS -->
            <Tab text="💳 Mi Tarjeta Virtual">
                <VBox spacing="20.0" style="-fx-padding: 20;">
                    <HBox spacing="20.0">
                        <VBox styleClass="dashboard-card" prefWidth="350.0" spacing="10.0">
                            <Label text="SALDO ACTUAL" styleClass="kpi-title"/>
                            <Label fx:id="lblSaldoTarjeta" text="\$ 0.00" styleClass="kpi-value" style="-fx-text-fill: #f5b041;"/>
                            <Label fx:id="lblIdTarjeta" text="Tarjeta #0000" styleClass="subtitle-text"/>
                        </VBox>
                        <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" spacing="10.0">
                            <Label text="Solicitar Recarga de Saldo" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Label text="Nota: La recarga será aprobada por un administrador." styleClass="subtitle-text"/>
                            <HBox spacing="10.0">
                                <TextField fx:id="txtMontoRecarga" promptText="Monto a recargar (ej. 50000)" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                                <Button text="Solicitar Recarga" styleClass="button-primary" onAction="#handleSolicitarRecarga"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <Label text="Historial de Movimientos" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFechaMov" text="Fecha" prefWidth="150.0"/>
                            <TableColumn fx:id="colTipoMov" text="Tipo de Movimiento" prefWidth="200.0"/>
                            <TableColumn fx:id="colMontoMov" text="Monto" prefWidth="150.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- PESTAÑA 2: MIS COMPRAS Y REEMBOLSOS -->
            <Tab text="🎟️ Historial de Compras">
                <VBox spacing="15.0" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tus compras realizadas (Puedes cancelar hasta 2 horas antes de la función)" styleClass="subtitle-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Cancelar Compra Seleccionada" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;" onAction="#handleSolicitarReembolso"/>
                    </HBox>
                    <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIdCompra" text="ID Compra" prefWidth="120.0"/>
                            <TableColumn fx:id="colFechaCompra" text="Fecha Compra" prefWidth="150.0"/>
                            <TableColumn fx:id="colDetalleCompra" text="Detalle" prefWidth="300.0"/>
                            <TableColumn fx:id="colTotalCompra" text="Valor Pagado" prefWidth="150.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- PESTAÑA 3: PROGRAMA DE PUNTOS -->
            <Tab text="⭐️ Mis Puntos CinemaUQ">
                <VBox spacing="15.0" style="-fx-padding: 20;">
                    <Label fx:id="lblTotalPuntosVigentes" text="Total Puntos Vigentes: 0 pts" style="-fx-text-fill: #f5b041; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Los puntos tienen vigencia de 1 año y se redimen automáticamente los más próximos a vencer." styleClass="subtitle-text"/>
                    <TableView fx:id="tablaPuntos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCantidadPuntos" text="Puntos Obtenidos" prefWidth="180.0"/>
                            <TableColumn fx:id="colFechaObtencion" text="Fecha de Obtención" prefWidth="180.0"/>
                            <TableColumn fx:id="colFechaVencimiento" text="Fecha de Vencimiento" prefWidth="180.0"/>
                            <TableColumn fx:id="colEstadoPuntos" text="Estado" prefWidth="150.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>