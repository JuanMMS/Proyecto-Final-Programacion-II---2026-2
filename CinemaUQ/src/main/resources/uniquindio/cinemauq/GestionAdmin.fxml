<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GestionAdminController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #14141d; -fx-padding: 20 30;">
            <Label text="⚙️ Panel de Operaciones y Reportes" styleClass="title-text" style="-fx-font-size: 22px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&lt; Volver a Estadísticas" styleClass="button-primary" onAction="#handleVolverDashboard"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #0d0d12; -fx-padding: 20;">

            <!-- PESTAÑA 1: PELÍCULAS Y FUNCIONES -->
            <Tab text="🎬 Películas y Funciones">
                <HBox spacing="20.0" style="-fx-padding: 20;">
                    <VBox spacing="12.0" styleClass="dashboard-card" prefWidth="350.0">
                        <Label text="Registrar Nueva Película" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <TextField fx:id="txtNombrePelicula" promptText="Título de la película" styleClass="text-field"/>
                        <TextField fx:id="txtDirectorPelicula" promptText="Director" styleClass="text-field"/>
                        <Button text="Guardar Película" maxWidth="Infinity" styleClass="button-primary" onAction="#handleCrearPelicula"/>

                        <Separator style="-fx-background-color: #2a2a35;"/>

                        <Label text="Programar Función" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <ComboBox fx:id="cmbPeliculaFuncion" promptText="Seleccionar Película" maxWidth="Infinity"/>
                        <ComboBox fx:id="cmbSalaFuncion" promptText="Seleccionar Sala" maxWidth="Infinity"/>
                        <DatePicker fx:id="dpFechaFuncion" promptText="Fecha de la función" maxWidth="Infinity"/>
                        <TextField fx:id="txtHoraFuncion" promptText="Hora (ej. 19:30)" styleClass="text-field"/>
                        <Button text="Programar Función" maxWidth="Infinity" styleClass="button-primary" onAction="#handleCrearFuncion"/>
                    </VBox>

                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Funciones Activas" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Cancelar Función (Reembolso 100%)" style="-fx-background-color: #f44336; -fx-text-fill: white;" onAction="#handleCancelarFuncion"/>
                        </HBox>
                        <TableView fx:id="tablaFunciones" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdFuncion" text="ID" prefWidth="80.0"/>
                                <TableColumn fx:id="colPeliculaFunc" text="Película" prefWidth="200.0"/>
                                <TableColumn fx:id="colSalaFunc" text="Sala" prefWidth="100.0"/>
                                <TableColumn fx:id="colFechaFunc" text="Fecha" prefWidth="120.0"/>
                                <TableColumn fx:id="colHoraFunc" text="Hora" prefWidth="100.0"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>
            </Tab>

            <!-- PESTAÑA 2: RECARGAS A CLIENTES -->
            <Tab text="💳 Recargar Tarjetas">
                <VBox spacing="20.0" style="-fx-padding: 20;" maxWidth="600.0">
                    <Label text="Aprobar y Realizar Recargas" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbClienteRecarga" promptText="Seleccione el Cliente / Cuenta" maxWidth="Infinity"/>
                    <TextField fx:id="txtValorRecargaAdmin" promptText="Valor a recargar ($)" styleClass="text-field"/>
                    <Button text="Acreditar Saldo a Tarjeta Virtual" styleClass="button-primary" onAction="#handleAcreditarRecarga"/>
                </VBox>
            </Tab>

            <!-- PESTAÑA 3: EXPORTACIÓN DE REPORTES -->
            <Tab text="📄 Exportar Reportes (PDF / TXT)">
                <VBox spacing="20.0" style="-fx-padding: 20;" maxWidth="650.0">
                    <Label text="Generador de Reportes Operativos" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <ComboBox fx:id="cmbTipoReporte" promptText="Seleccione el tipo de reporte..." maxWidth="Infinity"/>

                    <HBox spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Fecha Inicio:" styleClass="subtitle-text"/>
                            <DatePicker fx:id="dpReporteInicio" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label text="Fecha Fin:" styleClass="subtitle-text"/>
                            <DatePicker fx:id="dpReporteFin" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
                        <Button text="📄 Exportar a TXT" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="button-primary" onAction="#handleExportarTXT"/>
                        <Button text="📕 Exportar a PDF" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" onAction="#handleExportarPDF"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>