<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.LoginViewController">
    <!-- Fondo decorativo opcional -->
    <VBox alignment="CENTER" spacing="20.0" maxWidth="400.0" maxHeight="500.0" style="-fx-background-color: #14141d; -fx-padding: 40; -fx-background-radius: 15;">

        <!-- Espacio para el logo -->
        <ImageView fx:id="logoImageView" fitHeight="80.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/logo_cinemauq.png" />
            </image>
        </ImageView>

        <Label text="Bienvenido a CinemaUQ" styleClass="title-text"/>
        <Label text="Ingresa tus credenciales para continuar" styleClass="subtitle-text"/>

        <VBox spacing="15.0" style="-fx-padding: 20 0 0 0;">
            <TextField fx:id="txtUsuario" promptText="Usuario o Correo" styleClass="text-field"/>
            <PasswordField fx:id="txtContrasenia" promptText="Contraseña" styleClass="password-field"/>
        </VBox>

        <Button fx:id="btnIniciarSesion" text="INICIAR SESIÓN" maxWidth="Infinity" styleClass="button-primary" onAction="#handleIniciarSesion"/>

        <HBox alignment="CENTER" spacing="5.0">
            <Label text="¿No tienes cuenta?" styleClass="subtitle-text"/>
            <Hyperlink text="Regístrate aquí" fx:id="linkRegistro" style="-fx-text-fill: #f5b041; -fx-underline: true;"/>
        </HBox>
    </VBox>
</StackPane>